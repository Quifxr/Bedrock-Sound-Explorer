
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bedrock Sound Explorer</title>
<style>
:root {
  color-scheme: dark;
  --bg: #101713;
  --panel: #1b2720;
  --green: #57d68d;
  --muted: #a9b9ad;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: #f3fff5;
  font: 16px system-ui, sans-serif;
}
header { padding: 28px 18px; background: #17271d; }
main { max-width: 1050px; margin: auto; padding: 20px; }
h1 { margin: 0 0 8px; font-size: clamp(26px,5vw,40px); }
p { color: var(--muted); }
.controls {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 10px; margin: 18px 0;
}
input, select, button {
  font: inherit; padding: 12px; border-radius: 9px;
  border: 1px solid #405448; background: var(--panel);
  color: white; min-width: 0;
}
input { grid-column: 1 / -1; }
.tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
.tag {
  border-radius: 22px; padding: 8px 12px; cursor: pointer;
}
.tag.active { background: var(--green); color: #102117; }
#status { color: var(--muted); margin: 16px 0; }
#results { display: grid; gap: 10px; }
.sound {
  background: var(--panel); border: 1px solid #304337;
  border-radius: 12px; padding: 14px;
}
.sound-name { overflow-wrap: anywhere; font-weight: 700; }
.id { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
.pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
.pill { background: #304337; padding: 4px 8px; border-radius: 15px; font-size: 12px; }
.actions { display: flex; gap: 8px; margin-top: 10px; }
.actions button { cursor: pointer; }
button:hover { border-color: var(--green); }
@media(max-width:520px) {
  .controls { grid-template-columns: 1fr; }
  input { grid-column: auto; }
}
</style>
</head>
<body>
<header>
  <h1>🔊 Bedrock Sound Explorer</h1>
  <p>Search vanilla Minecraft Bedrock sound events by name, ID, or tag.</p>
</header>
<main>
  <div class="controls">
    <input id="search" placeholder="Search sounds or IDs..." aria-label="Search sounds">
    <select id="category" aria-label="Sound category">
      <option value="">All sound categories</option>
    </select>
    <select id="sort" aria-label="Sort results">
      <option value="name">Sort: Name A–Z</option>
      <option value="name-desc">Sort: Name Z–A</option>
      <option value="id">Sort: Event ID A–Z</option>
    </select>
  </div>
  <h3>Filter by tag</h3>
  <div id="tags" class="tags"></div>
  <div id="status">Loading vanilla Bedrock sound definitions…</div>
  <div id="results"></div>
  <button id="more" hidden>Load more</button>
  <p>Tags are automatic suggestions, not official Minecraft classifications.
  Audio previews may be unavailable for some files.</p>
</main>
<script>
const SOURCE =
  "https://raw.githubusercontent.com/Mojang/bedrock-samples/main/resource_pack/sounds/sound_definitions.json";
const AUDIO =
  "https://raw.githubusercontent.com/Mojang/bedrock-samples/main/resource_pack/";

const TAGS = [
  "Metal","Wool","Liquid","Steam","Wind","Wood","Stone","Glass",
  "Fire","Water","Animals","Mobs","Blocks","Tools","Magic","Nature",
  "Weather","Redstone","Footsteps","UI","Music","Explosions",
  "Doors","Chests","Combat","Mining","Movement","Amethyst","Ice"
];

let sounds = [];
let selectedTag = "All";
let visible = 60;
let currentAudio = null;

const $ = id => document.getElementById(id);

function inferTags(id, paths, category) {
  const s = (id + " " + paths.join(" ") + " " + category).toLowerCase();
  const out = [];
  const rules = {
    Metal: /metal|anvil|iron|chain|copper|gold|netherite|shield|bell/,
    Wool: /wool|carpet|sheep/,
    Liquid: /liquid|bucket|bottle|potion|pour|fill|empty/,
    Steam: /steam|sizzle|boil/,
    Wind: /wind|breeze|gust|elytra/,
    Wood: /wood|plank|log|bamboo|cherry|bamboo|barrel|door/,
    Stone: /stone|deepslate|cobble|gravel|rock|ore/,
    Glass: /glass|amethyst|crystal/,
    Fire: /fire|flame|lava|burn|blaze|campfire/,
    Water: /water|splash|swim|bubble|underwater|fishing/,
    Animals: /cow|sheep|pig|chicken|cat|dog|wolf|horse|frog|bee|fox|panda|parrot|rabbit|turtle|dolphin/,
    Mobs: /zombie|skeleton|creeper|enderman|spider|witch|warden|ghast|dragon|slime|villager|pillager|phantom|monster/,
    Blocks: /block|break|place|step|hit|fall|dig|activate|deactivate/,
    Tools: /tool|pickaxe|axe|shovel|hoe|shear|fishing_rod/,
    Magic: /enchant|spell|magic|portal|totem|experience|xp|beacon/,
    Nature: /forest|leaves|grass|flower|crop|vine|tree|ambient|cave/,
    Weather: /rain|thunder|lightning|weather/,
    Redstone: /redstone|piston|lever|button|repeater|comparator|dispenser|dropper/,
    Footsteps: /step|footstep|walk|run|sprint|land/,
    UI: /ui\.|button|menu|toast|notification|click|hover/,
    Music: /music|record|jukebox/,
    Explosions: /explode|explosion|tnt|firework/,
    Doors: /door|trapdoor|fence_gate/,
    Chests: /chest|shulker|ender_chest/,
    Combat: /attack|damage|hurt|death|hit|sword|trident|bow|crossbow/,
    Mining: /dig|mine|break|ore/,
    Movement: /jump|swim|fly|fall|climb|sprint/,
    Ice: /ice|snow|powder_snow|freeze/
  };
  for (const [tag, re] of Object.entries(rules))
    if (re.test(s)) out.push(tag);
  if (category) out.push(category[0].toUpperCase() + category.slice(1));
  return [...new Set(out)];
}

function getPaths(def) {
  const list = def?.sounds || [];
  return list.map(x => typeof x === "string" ? x : x?.name)
    .filter(Boolean);
}

function renderTags() {
  $("tags").replaceChildren();
  ["All", ...TAGS].forEach(tag => {
    const b = document.createElement("button");
    b.className = "tag" + (selectedTag === tag ? " active" : "");
    b.textContent = tag;
    b.onclick = () => {
      selectedTag = tag;
      visible = 60;
      renderTags();
      render();
    };
    $("tags").append(b);
  });
}

function filtered() {
  const q = $("search").value.trim().toLowerCase();
  const cat = $("category").value;
  return sounds.filter(s =>
    (!q || (s.id + " " + s.paths.join(" ") + " " + s.tags.join(" "))
      .toLowerCase().includes(q)) &&
    (!cat || s.category === cat) &&
    (selectedTag === "All" || s.tags.includes(selectedTag))
  ).sort((a,b) => {
    if ($("sort").value === "name-desc")
      return b.id.localeCompare(a.id);
    if ($("sort").value === "id")
      return a.id.localeCompare(b.id);
    return a.id.localeCompare(b.id);
  });
}

function playSound(s, button) {
  if (!s.paths.length) {
    $("status").textContent = "No audio path is listed for this event.";
    return;
  }
  // Try common Bedrock sample audio extensions.
  const candidates = [];
  for (const path of s.paths) {
    const clean = path.replace(/^sounds\//, "sounds/");
    candidates.push(AUDIO + clean + ".ogg");
    candidates.push(AUDIO + clean + ".wav");
  }
  let i = 0;
  if (currentAudio) {
    currentAudio.pause();
    currentAudio = null;
  }
  const audio = new Audio();
  currentAudio = audio;
  function tryNext() {
    if (i >= candidates.length) {
      $("status").textContent =
        "Preview unavailable for this sound in the sample repository.";
      return;
    }
    audio.src = candidates[i++];
    audio.onerror = tryNext;
    audio.play().then(() => {
      $("status").textContent = "Playing: " + s.id;
    }).catch(tryNext);
  }
  tryNext();
}

function render() {
  const all = filtered();
  const page = all.slice(0, visible);
  $("status").textContent =
    `${all.length.toLocaleString()} matching events · ${sounds.length.toLocaleString()} total loaded`;
  $("results").replaceChildren();
  page.forEach(s => {
    const card = document.createElement("article");
    card.className = "sound";
    const title = document.createElement("div");
    title.className = "sound-name";
    title.textContent = s.id;
    const id = document.createElement("div");
    id.className = "id";
    id.textContent = "Category: " + (s.category || "Unspecified");
    const pills = document.createElement("div");
    pills.className = "pills";
    s.tags.forEach(tag => {
      const p = document.createElement("span");
      p.className = "pill";
      p.textContent = tag;
      pills.append(p);
    });
    const actions = document.createElement("div");
    actions.className = "actions";
    const play = document.createElement("button");
    play.textContent = "▶ Preview";
    play.onclick = () => playSound(s, play);
    const copy = document.createElement("button");
    copy.textContent = "Copy event ID";
    copy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(s.id);
        copy.textContent = "Copied!";
      } catch {
        prompt("Copy this event ID:", s.id);
      }
    };
    actions.append(play, copy);
    card.append(title, id, pills, actions);
    $("results").append(card);
  });
  $("more").hidden = page.length >= all.length;
}

$("more").onclick = () => { visible += 60; render(); };
$("search").addEventListener("input", () => { visible = 60; render(); });
$("category").onchange = render;
$("sort").onchange = render;

async function init() {
  try {
    const response = await fetch(SOURCE);
    if (!response.ok) throw new Error("Source unavailable");
    const data = await response.json();
    const defs = data.sound_definitions || {};
    sounds = Object.entries(defs).map(([id, def]) => {
      const paths = getPaths(def);
      return {
        id,
        paths,
        category: def.category || "",
        tags: inferTags(id, paths, def.category || "")
      };
    });
    const categories = [...new Set(sounds.map(s => s.category).filter(Boolean))].sort();
    categories.forEach(c => {
      const option = document.createElement("option");
      option.value = c;
      option.textContent = c;
      $("category").append(option);
    });
    renderTags();
    render();
  } catch (e) {
    $("status").textContent =
      "Could not load sound definitions. Check your internet connection and try again.";
  }
}
init();
</script>
</body>
</html>
